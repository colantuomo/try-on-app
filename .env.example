# Replicate API Token
# Obtenha sua chave em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Alternar provedor de IA: replicate | gemini
IMAGE_PROVIDER=replicate

# Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de imagem Gemini
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# URL base da aplicação (necessário para o Replicate acessar as imagens)
# Em desenvolvimento local, use:
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Em produção (Vercel, etc), use a URL do seu deploy:
# NEXT_PUBLIC_BASE_URL=https://seu-app.vercel.app
